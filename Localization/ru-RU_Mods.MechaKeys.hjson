DisplayName: Mecha Keys

Configs: {
	MechaKeysConfig: {
		DisplayName: Mecha Keys

		Headers: {
			Preview: Mecha Keys
			General: Общее
			Keyboard: Клавиатура
			Mouse: Мышь
			Packs: Свои пакеты звуков
		}

		LogoPreview: {
			Label: ""
			Tooltip: ЛКМ — послушать пакет клавиатуры, ПКМ — пакет мыши.
		}

		QuickPresets: {
			Label: Быстрые пресеты
			Tooltip: Один клик подбирает звук клавиатуры и мыши. Ниже всё можно донастроить.
		}

		Enabled: {
			Label: Включить звуки нажатий
			Tooltip: Главный выключатель всех звуков Mecha Keys.
		}

		PlayWhen: {
			Label: Когда играть клики
			Tooltip:
				'''
				Везде: каждое нажатие, включая движение и горячие клавиши в игре.
				Меню и ввод текста: только в меню, инвентаре, чате и полях ввода — WASD во время игры молчит.
				Только ввод текста: только когда вы печатаете (чат, таблички, поиск, переименование).
				'''
		}

		FollowGameVolume: {
			Label: Учитывать громкость звука игры
			Tooltip: Вкл.: клики тише вместе с ползунком «Звук» в Terraria. Выкл.: клики его игнорируют — удобно, если звуки игры приглушены.
		}

		PitchVariation: {
			Label: Разброс высоты тона
			Tooltip: Слегка меняет тон каждого клика, чтобы быстрый набор не звучал роботизированно. 0% — как записано.
		}

		HeavierBigKeys: {
			Label: Глубже Пробел, Enter и Backspace
			Tooltip: Большие клавиши звучат чуть ниже, как настоящий пробел со стабилизатором.
		}

		StereoKeys: {
			Label: Стерео-клавиатура
			Tooltip: Клавиши слева звучат из левого динамика, справа — из правого. Лучше всего в наушниках.
		}

		IgnoreModifiers: {
			Label: Без звука для Shift, Ctrl, Alt и Win
			Tooltip: Клавиши-модификаторы не щёлкают. Удобно, если в игре часто зажимаете Shift или Ctrl.
		}

		KeyboardSounds: {
			Label: Звуки клавиатуры
			Tooltip: Клик при каждом нажатии клавиши.
		}

		KeyboardPack: {
			Label: Свитч
			Tooltip: Стрелки (или ЛКМ / ПКМ по строке) листают свитчи. Каждая смена сразу проигрывает пример.
		}

		KeyboardVolume: {
			Label: Громкость клавиатуры
			Tooltip: Громкость кликов клавиатуры.
		}

		KeyboardAmplify: {
			Label: Усиление клавиатуры
			Tooltip: Проигрывает несколько копий клика одновременно. 1 — естественно; повышайте, только если на 100% всё ещё тихо.
		}

		TestKeyboard: {
			Label: Проверить звук клавиатуры
			Tooltip: Проиграть пример текущего свитча.
		}

		MouseSounds: {
			Label: Звуки мыши
			Tooltip: Клик по левой и правой кнопкам мыши.
		}

		MouseExtraButtons: {
			Label: Также средняя и боковые кнопки
			Tooltip: Щёлкают и колесо, и две боковые кнопки.
		}

		MouseSameAsKeyboard: {
			Label: Мышь звучит как клавиатура
			Tooltip: Вкл. — один звук для всего. Выкл. — отдельный звук мыши ниже.
		}

		MousePack: {
			Label: Свитч мыши
			Tooltip: Сначала идут мышиные свитчи, но подойдёт любой пакет.
		}

		MouseVolume: {
			Label: Громкость мыши
			Tooltip: Громкость кликов мыши.
		}

		MouseAmplify: {
			Label: Усиление мыши
			Tooltip: Несколько копий клика мыши одновременно. 1 — естественно.
		}

		TestMouse: {
			Label: Проверить звук мыши
			Tooltip: Проиграть пример текущего свитча мыши.
		}

		OpenSoundFolder: {
			Label: Открыть папку пакетов
			Tooltip: Кладите сюда .ogg / .wav, папки с ними или .zip. Подробности — в HOW_TO_ADD.txt внутри. Не используйте .jar.
		}

		RescanSoundFolder: {
			Label: Пересканировать пакеты
			Tooltip: Перечитать пакеты после добавления или удаления файлов. Новые сразу появятся в списках.
		}
	}

	PlayMode: {
		Tooltip: ""

		Everywhere: {
			Label: Везде
			Tooltip: ""
		}

		MenusAndTyping: {
			Label: Меню и ввод текста
			Tooltip: ""
		}

		TypingOnly: {
			Label: Только ввод текста
			Tooltip: ""
		}
	}
}

UI: {
	SameAsKeyboard: как у клавиатуры
	MouseLinked: Включено «Мышь звучит как клавиатура», поэтому эта настройка не используется.
	Keyboard: Клавиатура
	Mouse: Мышь
	Off: ВЫКЛ
	PackCount: Пакетов: {0}
}

Kinds: {
	Linear: Линейный
	Tactile: Тактильный
	Clicky: Кликающий
	Silent: Тихий
	Special: Винтаж
	Mouse: Мышь
	Custom: Свой
}

Presets: {
	Clicky: {
		Label: Клик
		Tooltip: Kailh Box Jade и классический клик мыши. Громко, чётко, приятно.
	}

	Tactile: {
		Label: Тактиль
		Tooltip: Holy Panda: округлый «бугорок» и глубокий удар в дно.
	}

	Linear: {
		Label: Линейный
		Tooltip: Плавный Gateron Yellow и чёткая оптическая мышь.
	}

	Thocky: {
		Label: Глубокий
		Tooltip: Смазанный Oil King с глубоким «thock» и мягкая мышь.
	}

	Retro: {
		Label: Ретро
		Tooltip: Старая клавиатура на пружинах (buckling spring): громко, звонко, узнаваемо.
	}

	Quiet: {
		Label: Тихо
		Tooltip: Тихие свитчи на 70% громкости. Для поздних вечеров.
	}
}

